---
import Base from '../layouts/Base.astro';
import SocialIcons from '../components/SocialIcons.astro';
import SubscribeBand from '../components/SubscribeBand.astro';
import { SITE, LINKS, FORM_ENDPOINT, href } from '../config';

/** Calendly inline embed, themed to match the site (hex values without '#'). */
const calendlyEmbedUrl = `${LINKS.calendly}?hide_gdpr_banner=1&background_color=121722&text_color=f2eee5&primary_color=d8b36a`;
---

<Base title="Contact | Joseph Alvarado Real Estate Agent and Investor">
  <section class="section page-hero">
    <div class="container">
      <span class="kicker">Contact me</span>
      <h1>Let's get the conversation started!</h1>
      <p class="lede">I'll answer any of your questions — free of charge!</p>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container contact-layout">
      <form
        class="card contact-form"
        method="POST"
        action={FORM_ENDPOINT || undefined}
        data-fallback-email={SITE.email}
        data-fallback-subject="Website inquiry"
      >
        <div class="field">
          <label for="name">Name *</label>
          <input id="name" name="name" type="text" required />
        </div>
        <div class="field">
          <label for="email">Email *</label>
          <input id="email" name="email" type="email" required />
        </div>
        <div class="field">
          <label for="inquiry">Inquiry Type *</label>
          <select id="inquiry" name="inquiry" required>
            <option value="">Select one…</option>
            <option>Buying</option>
            <option>Selling</option>
            <option>Investing</option>
            <option>Other</option>
          </select>
        </div>
        <div class="field">
          <label for="message">Message *</label>
          <textarea id="message" name="message" rows="6" required></textarea>
        </div>
        <label class="terms">
          <input type="checkbox" required />
          <span>I accept the <a href={href('/privacy-policy/')}>Terms</a></span>
        </label>
        <button class="btn btn-gold" type="submit">Send Message</button>
      </form>

      <aside class="contact-info">
        <div class="info-block">
          <h3>Email</h3>
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </div>
        <div class="info-block">
          <h3>Phone</h3>
          <a href={SITE.phoneHref}>{SITE.phone}</a>
        </div>
        <div class="info-block">
          <h3>Office</h3>
          <p>{SITE.office}</p>
        </div>
        <div class="info-block">
          <h3>Prefer to talk?</h3>
          <a class="btn btn-ghost" href="#book">Book a Free 30-min Call</a>
        </div>
        <div class="info-block">
          <h3>Socials</h3>
          <SocialIcons />
        </div>
      </aside>
    </div>
  </section>

  <section class="section" id="book" style="padding-top: 0;">
    <div class="container">
      <div class="section-head center">
        <span class="kicker">Prefer to talk?</span>
        <h2>Book a free 30-minute call</h2>
        <p class="lede">
          Pick a time that works for you and we'll talk through your goals — no pressure, no
          obligation.
        </p>
      </div>
      <div class="calendly-card">
        <div class="calendly-inline-widget" data-url={calendlyEmbedUrl}></div>
      </div>
      <p class="calendly-fallback">
        Widget not loading?
        <a href={LINKS.calendly} target="_blank" rel="noopener">Open the scheduler directly &rarr;</a>
      </p>
    </div>
  </section>
  <script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>

  <SubscribeBand />
</Base>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-fallback-email]')) {
    if (form.getAttribute('action')) continue;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = form.dataset.fallbackEmail;
      const subject = encodeURIComponent(form.dataset.fallbackSubject ?? 'Website inquiry');
      const body = encodeURIComponent(
        [...new FormData(form).entries()].map(([k, v]) => `${k}: ${v}`).join('\n')
      );
      window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
    });
  }
</script>

<style>
  .page-hero {
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .contact-form {
    padding: 2rem;
    display: grid;
    gap: 1.3rem;
  }

  .terms {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .terms input {
    accent-color: var(--gold);
    width: 1.05rem;
    height: 1.05rem;
  }

  .contact-form .btn {
    justify-self: start;
  }

  .contact-info {
    display: grid;
    gap: 1.8rem;
  }

  .info-block h3 {
    font-family: var(--sans);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.4rem;
  }

  .info-block a:not(.btn) {
    color: var(--text);
    font-size: 1.05rem;
  }

  .info-block a:not(.btn):hover {
    color: var(--gold-bright);
  }

  .info-block p {
    color: var(--text);
  }

  .calendly-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .calendly-inline-widget {
    width: 100%;
    min-width: 320px;
    height: 700px;
  }

  .calendly-fallback {
    margin-top: 1rem;
    text-align: center;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .calendly-fallback a {
    color: var(--gold);
  }

  .calendly-fallback a:hover {
    color: var(--gold-bright);
  }

  @media (max-width: 860px) {
    .contact-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
