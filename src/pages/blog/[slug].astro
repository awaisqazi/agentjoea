---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import SubscribeBand from '../../components/SubscribeBand.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title, date, excerpt, cover } = entry.data;
const { Content } = await render(entry);

const formatted = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const more = (await getCollection('blog'))
  .filter((p) => p.id !== entry.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base title={`${title} | Joe's Thoughts`} description={excerpt}>
  <article>
    <section class="section post-hero">
      <div class="container narrow">
        <time datetime={date.toISOString().slice(0, 10)}>{formatted}</time>
        <h1>{title}</h1>
      </div>
    </section>

    <div class="container narrow">
      <Image src={cover} alt="" class="cover" width={1400} loading="eager" quality={75} />
      <div class="prose post-body">
        <Content />
      </div>
    </div>
  </article>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="kicker">More blog posts</span>
        <h2>Keep reading</h2>
      </div>
      <div class="grid-3">
        {more.map((post) => (
          <PostCard entry={post} />
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    title="Ready to talk real estate?"
    text="Buying, selling, or investing — reach out and I'll answer any of your questions, free of charge."
  />
  <SubscribeBand />
</Base>

<style>
  .post-hero {
    padding-bottom: 2rem;
  }

  .narrow {
    max-width: 820px;
  }

  time {
    display: block;
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1rem;
  }

  :global(.cover) {
    border-radius: var(--radius);
    border: 1px solid var(--line);
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 8;
    object-fit: cover;
  }

  .post-body {
    margin: 2.5rem auto 4rem;
  }
</style>
