---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { href } from '../config';

interface Props {
  entry: CollectionEntry<'properties'>;
  loading?: 'eager' | 'lazy';
}

const { entry, loading = 'lazy' } = Astro.props;
const { title, summary, tag, card } = entry.data;
---

<a class="card property-card" href={href(`/properties/${entry.id}/`)}>
  <div class="thumb">
    <Image src={card} alt={`${title} — ${tag} property`} width={720} loading={loading} />
    <span class="badge">{tag}</span>
  </div>
  <div class="body">
    <h3>{title}</h3>
    <p>{summary}</p>
    <span class="view">View project →</span>
  </div>
</a>

<style>
  .property-card {
    display: block;
    color: var(--text);
  }

  .thumb {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .property-card:hover .thumb img {
    transform: scale(1.05);
  }

  .thumb .badge {
    position: absolute;
    top: 0.9rem;
    left: 0.9rem;
    background: rgba(11, 14, 19, 0.75);
    backdrop-filter: blur(6px);
  }

  .body {
    padding: 1.3rem 1.4rem 1.5rem;
  }

  .body h3 {
    margin-bottom: 0.35rem;
  }

  .body p {
    color: var(--muted);
    font-size: 0.95rem;
    margin-bottom: 0.9rem;
  }

  .view {
    color: var(--gold);
    font-size: 0.88rem;
    font-weight: 650;
    letter-spacing: 0.04em;
  }

  .property-card:hover .view {
    color: var(--gold-bright);
  }
</style>
