---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  before: ImageMetadata[];
  after: ImageMetadata[];
  title: string;
}

const { before, after, title } = Astro.props;

const sets = [
  { key: 'before', label: 'Before', images: before },
  { key: 'after', label: 'After', images: after },
] as const;
---

<div class="ba" data-ba>
  <div class="ba-head">
    <div class="ba-head-copy">
      <span class="kicker">The transformation</span>
      <h2>Before &amp; After</h2>
      <p class="ba-lede">Same rooms, same walls — flip between the day I got the keys and the finished result.</p>
    </div>
    <div class="ba-toggle" data-ba-toggle>
      <span class="ba-toggle-thumb" aria-hidden="true"></span>
      {sets.map((set, i) => (
        <button
          type="button"
          class="ba-toggle-btn"
          data-ba-tab={set.key}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {set.label}
        </button>
      ))}
    </div>
    <button type="button" class="ba-close" data-ba-close aria-label="Close fullscreen viewer">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
  </div>

  <div class="ba-stage">
    {sets.map((set, setIdx) => (
      <section class="ba-panel" data-ba-panel={set.key} data-active={setIdx === 0 ? 'true' : 'false'}>
        <h3 class="ba-fallback-label">
          <span class="badge">{set.label}</span>
        </h3>

        <div class="ba-frame" data-ba-frame tabindex="-1">
          {set.images.map((img, i) => (
            <figure class="ba-slide" data-active={i === 0 ? 'true' : 'false'}>
              <Image
                src={img}
                alt=""
                class="ba-slide-bg"
                aria-hidden="true"
                width={480}
                quality={35}
                loading="lazy"
              />
              <Image
                src={img}
                alt={`${title} — ${set.label.toLowerCase()} photo ${i + 1} of ${set.images.length}`}
                class="ba-slide-img"
                widths={[640, 1000, 1600]}
                sizes="(max-width: 700px) 94vw, 92vw"
                loading="lazy"
                quality={78}
              />
            </figure>
          ))}

          <span class={`ba-frame-badge ba-frame-badge-${set.key}`} aria-hidden="true">{set.label}</span>
          <span class="ba-count" data-ba-count aria-hidden="true">1 / {set.images.length}</span>

          <button type="button" class="ba-expand" data-ba-expand aria-label="View photos fullscreen">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>

          <button type="button" class="ba-nav ba-nav-prev" data-ba-nav="-1" aria-label={`Previous ${set.label.toLowerCase()} photo`}>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14.5 5.5 8 12l6.5 6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="ba-nav ba-nav-next" data-ba-nav="1" aria-label={`Next ${set.label.toLowerCase()} photo`}>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9.5 5.5 16 12l-6.5 6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>

        <div class="ba-strip" data-ba-strip role="group" aria-label={`${set.label} photos`}>
          {set.images.map((img, i) => (
            <button
              type="button"
              class="ba-thumb"
              data-ba-thumb={i}
              aria-label={`${set.label} photo ${i + 1} of ${set.images.length}`}
              aria-current={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              <Image src={img} alt="" width={280} quality={70} loading="lazy" />
            </button>
          ))}
        </div>
      </section>
    ))}
  </div>
</div>

<style>
  .ba-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 2.5rem;
    margin-bottom: clamp(1.6rem, 4vw, 2.4rem);
  }

  .ba-head-copy {
    max-width: 34rem;
  }

  .ba-lede {
    color: var(--muted);
    margin-top: 0.7rem;
    font-size: 1rem;
  }

  /* ---------- segmented toggle (JS only) ---------- */
  .ba-toggle {
    display: none;
    position: relative;
    isolation: isolate;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    padding: 0.3rem;
    flex-shrink: 0;
  }

  .ba.is-on .ba-toggle {
    display: inline-flex;
  }

  .ba-toggle-btn {
    position: relative;
    z-index: 1;
    appearance: none;
    border: 0;
    background: transparent;
    font-family: var(--sans);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 0.62rem 1.7rem;
    border-radius: 999px;
    cursor: pointer;
    transition: color 0.3s ease;
    min-width: 7.5rem;
  }

  .ba-toggle-btn[aria-pressed='true'] {
    color: var(--ink);
  }

  .ba-toggle-btn:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
  }

  .ba-toggle-thumb {
    position: absolute;
    z-index: 0;
    top: 0.3rem;
    bottom: 0.3rem;
    left: 0.3rem;
    width: calc(50% - 0.3rem);
    border-radius: 999px;
    background: linear-gradient(180deg, var(--gold-bright), var(--gold));
    box-shadow: 0 2px 12px rgba(216, 179, 106, 0.35);
    transition: transform 0.35s cubic-bezier(0.33, 1, 0.44, 1);
  }

  .ba.view-after .ba-toggle-thumb {
    transform: translateX(100%);
  }

  /* ---------- stage & panels ---------- */
  .ba.is-on .ba-stage {
    display: grid;
  }

  .ba.is-on .ba-panel {
    grid-area: 1 / 1;
    transition: opacity 0.45s ease, visibility 0s linear 0.45s;
    opacity: 0;
    visibility: hidden;
  }

  .ba.is-on .ba-panel[data-active='true'] {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.45s ease;
  }

  .ba.is-on .ba-fallback-label {
    display: none;
  }

  /* no-JS fallback: both sets stacked with badge headings, simple grids */
  .ba-panel + .ba-panel {
    margin-top: 2.6rem;
  }

  .ba.is-on .ba-panel + .ba-panel {
    margin-top: 0;
  }

  .ba-fallback-label {
    margin-bottom: 1rem;
  }

  .ba-fallback-label .badge {
    font-size: 0.8rem;
    padding: 0.4rem 1.2rem;
  }

  /* ---------- featured frame ---------- */
  .ba-frame {
    position: relative;
    border-radius: var(--radius);
  }

  .ba-slide {
    margin: 0;
  }

  /* fallback: frame is a simple responsive grid of full images */
  .ba:not(.is-on) .ba-frame {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: 0.9rem;
  }

  .ba:not(.is-on) .ba-slide :global(img.ba-slide-bg) {
    display: none;
  }

  .ba:not(.is-on) .ba-slide :global(img.ba-slide-img) {
    width: 100%;
    height: auto;
    border-radius: 10px;
    border: 1px solid var(--line);
  }

  .ba:not(.is-on) .ba-frame-badge,
  .ba:not(.is-on) .ba-count,
  .ba:not(.is-on) .ba-nav,
  .ba:not(.is-on) .ba-expand,
  .ba:not(.is-on) .ba-strip,
  .ba-close {
    display: none;
  }

  /* enhanced: fixed-aspect stage, crossfading slides over a blurred backdrop */
  .ba.is-on .ba-frame {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface);
    box-shadow: 0 24px 60px -28px rgba(0, 0, 0, 0.8);
    transition: border-color 0.45s ease;
    cursor: zoom-in;
  }

  .ba.is-on.view-after .ba-panel[data-active='true'] .ba-frame {
    border-color: var(--gold-dim);
  }

  .ba.is-on .ba-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.45s ease;
    pointer-events: none;
  }

  .ba.is-on .ba-slide[data-active='true'] {
    opacity: 1;
  }

  .ba.is-on .ba-slide :global(img.ba-slide-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(26px) brightness(0.4) saturate(0.85);
    transform: scale(1.15);
  }

  .ba.is-on .ba-slide :global(img.ba-slide-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: scale(1.015);
    transition: transform 0.6s ease;
  }

  .ba.is-on .ba-slide[data-active='true'] :global(img.ba-slide-img) {
    transform: scale(1);
  }

  .ba-frame:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
  }

  /* corner badge + counter */
  .ba-frame-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 2;
    padding: 0.34rem 1.05rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    backdrop-filter: blur(6px);
  }

  .ba-frame-badge-before {
    background: rgba(11, 14, 19, 0.72);
    border: 1px solid var(--line);
    color: var(--muted);
  }

  .ba-frame-badge-after {
    background: linear-gradient(180deg, var(--gold-bright), var(--gold));
    border: 1px solid var(--gold);
    color: var(--ink);
    box-shadow: 0 2px 14px rgba(216, 179, 106, 0.4);
  }

  .ba-count {
    position: absolute;
    bottom: 0.9rem;
    right: 1rem;
    z-index: 2;
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    color: var(--text);
    background: rgba(11, 14, 19, 0.72);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.22rem 0.8rem;
    backdrop-filter: blur(6px);
    font-variant-numeric: tabular-nums;
  }

  /* expand / close / prev / next buttons share the glass look */
  .ba-expand,
  .ba-nav,
  .ba-close {
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgba(11, 14, 19, 0.66);
    color: var(--text);
    cursor: pointer;
    backdrop-filter: blur(6px);
    transition: opacity 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .ba-expand {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    z-index: 2;
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    opacity: 0.75;
  }

  .ba-expand svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .ba-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    display: inline-flex;
    width: 2.7rem;
    height: 2.7rem;
    opacity: 0.75;
  }

  .ba-nav svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .ba-expand:hover,
  .ba-expand:focus-visible,
  .ba-nav:hover,
  .ba-nav:focus-visible,
  .ba-close:hover,
  .ba-close:focus-visible {
    opacity: 1;
    border-color: var(--gold);
    color: var(--gold-bright);
  }

  .ba-expand:focus-visible,
  .ba-nav:focus-visible,
  .ba-close:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }

  .ba-nav-prev { left: 0.9rem; }
  .ba-nav-next { right: 0.9rem; }

  /* ---------- filmstrip ---------- */
  .ba-strip {
    display: flex;
    gap: 0.7rem;
    margin-top: 0.9rem;
    overflow-x: auto;
    padding-bottom: 0.4rem;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }

  .ba-thumb {
    appearance: none;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    cursor: pointer;
    overflow: hidden;
    flex: 0 0 auto;
    opacity: 0.55;
    transition: opacity 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }

  .ba-thumb :global(img) {
    width: 108px;
    height: 76px;
    object-fit: cover;
    display: block;
  }

  .ba-thumb:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  .ba-thumb[aria-current='true'] {
    opacity: 1;
    border-color: var(--gold);
    box-shadow: 0 0 0 1px var(--gold-dim);
  }

  .ba-thumb:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
    opacity: 1;
  }

  /* ---------- fullscreen viewer ---------- */
  .ba.is-full {
    position: fixed;
    inset: 0;
    z-index: 2000;
    background: rgba(8, 10, 14, 0.99);
    display: flex;
    flex-direction: column;
    padding: clamp(0.9rem, 2.5vw, 2rem);
    overflow: hidden;
  }

  .ba.is-full .ba-head {
    flex: 0 0 auto;
    justify-content: center;
    align-items: center;
    margin-bottom: clamp(0.8rem, 2vw, 1.4rem);
    padding-right: 3.4rem;
    padding-left: 3.4rem;
  }

  .ba.is-full .ba-head-copy {
    display: none;
  }

  .ba.is-full .ba-close {
    display: inline-flex;
    position: absolute;
    top: clamp(0.9rem, 2.5vw, 2rem);
    right: clamp(0.9rem, 2.5vw, 2rem);
    width: 2.7rem;
    height: 2.7rem;
    opacity: 0.85;
    z-index: 3;
  }

  .ba-close svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .ba.is-full .ba-stage {
    flex: 1 1 auto;
    min-height: 0;
    grid-template-rows: minmax(0, 1fr);
    grid-template-columns: minmax(0, 1fr);
  }

  .ba.is-full .ba-panel {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .ba.is-full .ba-frame {
    aspect-ratio: auto;
    flex: 1 1 auto;
    min-height: 0;
    cursor: default;
    box-shadow: none;
  }

  .ba.is-full .ba-expand {
    display: none;
  }

  .ba.is-full .ba-strip {
    flex: 0 0 auto;
    justify-content: safe center;
  }

  @media (max-width: 700px) {
    .ba.is-on:not(.is-full) .ba-frame {
      aspect-ratio: 4 / 3;
    }

    .ba-toggle {
      width: 100%;
    }

    .ba.is-on .ba-toggle {
      display: flex;
    }

    .ba.is-full .ba-toggle {
      width: auto;
    }

    .ba-toggle-btn {
      flex: 1;
      min-width: 0;
    }

    .ba-nav {
      width: 2.3rem;
      height: 2.3rem;
    }

    .ba-thumb :global(img) {
      width: 88px;
      height: 62px;
    }

    .ba.is-full .ba-head {
      padding-right: 0;
      padding-left: 0;
      justify-content: flex-start;
    }

    .ba.is-full .ba-toggle {
      margin-right: 3.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ba-toggle-thumb,
    .ba.is-on .ba-panel,
    .ba.is-on .ba-slide,
    .ba.is-on .ba-slide :global(img.ba-slide-img),
    .ba-thumb {
      transition: none;
    }
  }
</style>

<script>
  function initBeforeAfter(root: HTMLElement) {
    const toggle = root.querySelector<HTMLElement>('[data-ba-toggle]');
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-ba-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-ba-panel]'));
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-ba-close]');
    if (!toggle || tabs.length !== 2 || panels.length !== 2) return;

    root.classList.add('is-on');

    interface PanelState {
      key: string;
      el: HTMLElement;
      frame: HTMLElement;
      slides: HTMLElement[];
      thumbs: HTMLButtonElement[];
      count: HTMLElement | null;
      index: number;
    }

    const states: PanelState[] = panels.map((el) => ({
      key: el.dataset.baPanel || '',
      el,
      frame: el.querySelector<HTMLElement>('[data-ba-frame]')!,
      slides: Array.from(el.querySelectorAll<HTMLElement>('.ba-slide')),
      thumbs: Array.from(el.querySelectorAll<HTMLButtonElement>('[data-ba-thumb]')),
      count: el.querySelector<HTMLElement>('[data-ba-count]'),
      index: 0,
    }));

    let activeSet = 0;
    let lastFocus: HTMLElement | null = null;
    let suppressClick = false;

    function setSlide(state: PanelState, index: number, focusThumb = false) {
      const n = state.slides.length;
      const next = ((index % n) + n) % n;
      const changed = next !== state.index;
      state.index = next;
      state.slides.forEach((slide, i) => {
        slide.dataset.active = i === state.index ? 'true' : 'false';
      });
      state.thumbs.forEach((btn, i) => {
        const current = i === state.index;
        btn.setAttribute('aria-current', current ? 'true' : 'false');
        btn.tabIndex = current ? 0 : -1;
        if (current && changed) {
          btn.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
          if (focusThumb) btn.focus({ preventScroll: true });
        }
      });
      if (state.count) state.count.textContent = `${state.index + 1} / ${n}`;
    }

    function setView(setIdx: number, focusTab = false) {
      activeSet = setIdx;
      root.classList.toggle('view-after', setIdx === 1);
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-pressed', i === setIdx ? 'true' : 'false');
        if (i === setIdx && focusTab) tab.focus();
      });
      states.forEach((state, i) => {
        const active = i === setIdx;
        state.el.dataset.active = active ? 'true' : 'false';
        state.el.setAttribute('aria-hidden', active ? 'false' : 'true');
        if ('inert' in state.el) (state.el as HTMLElement & { inert: boolean }).inert = !active;
      });
    }

    /* ---------- fullscreen ---------- */
    function isFull() {
      return root.classList.contains('is-full');
    }

    function onFullKeydown(e: KeyboardEvent) {
      if (e.key === 'Escape') {
        e.preventDefault();
        closeFull();
        return;
      }
      if ((e.key === 'ArrowLeft' || e.key === 'ArrowRight') && !e.defaultPrevented) {
        e.preventDefault();
        setSlide(states[activeSet], states[activeSet].index + (e.key === 'ArrowRight' ? 1 : -1));
        return;
      }
      if (e.key === 'Tab') {
        const els = Array.from(
          root.querySelectorAll<HTMLElement>('button, [tabindex]')
        ).filter(
          (el) =>
            el.tabIndex >= 0 &&
            el.getClientRects().length > 0 &&
            getComputedStyle(el).visibility !== 'hidden' &&
            !el.closest('[aria-hidden="true"]')
        );
        if (els.length === 0) return;
        const first = els[0];
        const last = els[els.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    }

    function openFull(from?: HTMLElement) {
      if (isFull()) return;
      lastFocus = (from ?? document.activeElement) as HTMLElement;
      root.classList.add('is-full');
      root.setAttribute('role', 'dialog');
      root.setAttribute('aria-modal', 'true');
      root.setAttribute('aria-label', 'Before and after photo viewer');
      document.documentElement.style.overflow = 'hidden';
      document.addEventListener('keydown', onFullKeydown);
      closeBtn?.focus();
    }

    function closeFull() {
      if (!isFull()) return;
      root.classList.remove('is-full');
      root.removeAttribute('role');
      root.removeAttribute('aria-modal');
      root.removeAttribute('aria-label');
      document.documentElement.style.overflow = '';
      document.removeEventListener('keydown', onFullKeydown);
      lastFocus?.focus();
      lastFocus = null;
    }

    closeBtn?.addEventListener('click', () => closeFull());

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => setView(i));
    });

    toggle.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
        e.preventDefault();
        setView(activeSet === 0 ? 1 : 0, true);
      }
    });

    states.forEach((state) => {
      state.el.querySelectorAll<HTMLButtonElement>('[data-ba-nav]').forEach((btn) => {
        btn.addEventListener('click', () => {
          setSlide(state, state.index + Number(btn.dataset.baNav));
        });
      });

      const expandBtn = state.el.querySelector<HTMLButtonElement>('[data-ba-expand]');
      expandBtn?.addEventListener('click', () => openFull(expandBtn));

      state.frame.addEventListener('click', (e) => {
        if (isFull() || suppressClick) return;
        const target = e.target as HTMLElement;
        if (target.closest('button')) return;
        openFull(state.frame);
      });

      state.thumbs.forEach((btn, i) => {
        btn.addEventListener('click', () => setSlide(state, i));
      });

      const strip = state.el.querySelector<HTMLElement>('[data-ba-strip]');
      strip?.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
          e.preventDefault();
          setSlide(state, state.index + (e.key === 'ArrowRight' ? 1 : -1), true);
        } else if (e.key === 'Home') {
          e.preventDefault();
          setSlide(state, 0, true);
        } else if (e.key === 'End') {
          e.preventDefault();
          setSlide(state, state.slides.length - 1, true);
        }
      });

      state.frame.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
          e.preventDefault();
          setSlide(state, state.index + (e.key === 'ArrowRight' ? 1 : -1));
        }
      });

      // swipe support
      let startX = 0;
      let startY = 0;
      let tracking = false;
      state.frame.addEventListener(
        'pointerdown',
        (e) => {
          startX = e.clientX;
          startY = e.clientY;
          tracking = true;
        },
        { passive: true }
      );
      state.frame.addEventListener(
        'pointerup',
        (e) => {
          if (!tracking) return;
          tracking = false;
          const dx = e.clientX - startX;
          const dy = e.clientY - startY;
          if (Math.abs(dx) > 44 && Math.abs(dx) > Math.abs(dy) * 1.5) {
            suppressClick = true;
            setTimeout(() => (suppressClick = false), 0);
            setSlide(state, state.index + (dx < 0 ? 1 : -1));
          }
        },
        { passive: true }
      );
    });

    setView(0);
  }

  document.querySelectorAll<HTMLElement>('[data-ba]').forEach(initBeforeAfter);
</script>
