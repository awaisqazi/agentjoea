---
interface Props {
  items: { q: string; a: string[] }[];
}

const { items } = Astro.props;
---

<div class="faq">
  {items.map((item, i) => (
    <details open={i === 0}>
      <summary>{item.q}</summary>
      <div class="faq-body">
        {item.a.map((para) => <p>{para}</p>)}
      </div>
    </details>
  ))}
</div>
