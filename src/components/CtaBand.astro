---
import { LINKS, SITE, href } from '../config';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Still have questions?',
  text = "Don't hesitate to reach out — all consultations, discussions, and advice are free of charge.",
} = Astro.props;
---

<section class="section cta-band">
  <div class="container inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="actions">
      <a class="btn btn-gold" href={LINKS.calendly} target="_blank" rel="noopener">Book a Call</a>
      <a class="btn btn-ghost" href={href('/contact/')}>Contact Me</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background:
      radial-gradient(ellipse 60% 120% at 85% 50%, rgba(216, 179, 106, 0.12), transparent),
      var(--surface);
    border-block: 1px solid var(--line);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .inner p {
    color: var(--muted);
    max-width: 34rem;
    margin-top: 0.6rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }
</style>
